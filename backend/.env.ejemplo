# ====================================================================
# Configuración del Entorno TechLoop
# ====================================================================

# Puerto del servidor backend en localhost
PUERTO=3000

# Clave secreta para firmar y validar tokens JWT
JWT_SECRET=clave_super_secreta_techloop_2026

# Cadena de conexión a Supabase (PostgreSQL)
# Puedes obtenerla en Supabase en: Project Settings -> Database -> Connection String -> URI
# Ejemplo: postgres://postgres.TU_REF:[TU_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Si dejas esta variable vacía o comentada, el servidor usará la base de datos de respaldo en memoria.
DATABASE_URL=
